server {
    listen 443 ssl;
    server_name auth.${NGINX_DOMAIN};

    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    location / {
        proxy_pass http://keycloak:${PORT_AUTH}/;
        proxy_set_header Host $host;
