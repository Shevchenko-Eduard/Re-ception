<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Project">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ItemGroup" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element name="PackageReference" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="Include" type="xs:ID" use="required" />
                  <xs:attribute name="Version" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="FrameworkReference" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="Include" use="required" />
                  <xs:attribute name="Version" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="ProjectReference" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="Include" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="Sdk" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>