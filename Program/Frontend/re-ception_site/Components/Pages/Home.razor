@page "/"

<PageTitle>Re:ception</PageTitle>
<div class="home_container">
    <!-- Hero intro -->
    <section class="hero">
        <div class="hero-content">
            <h1>Hotel network <span class="logo">Re:Ception</span></h1>
            <p>Experience breathtaking views, fine dining, and impeccable service in the heart of the city.</p>
        </div>
    </section>
    <div class="gallery-section">
        <div class="section-title">
            <h2>Signature Stays & Experiences</h2>
            <span></span>
            <p style="margin-top: 1rem; color: #7b623f;">Each space tells a story — curated for comfort and beauty</p>
        </div>

        <div class="hotel-grid">
            <!-- CARD 1 - Presidential Suite -->
            <div class="hotel-card">
                <div class="card-img">
                    <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Presidential+Suite" alt="Presidential Suite - Grand Horizon">
                </div>
                <div class="card-content">
                    <h3>Presidential Suite</h3>
                    <div class="card-location">Ocean View • Top Floor</div>
                    <div class="card-description">
                        Spacious 120m² suite with panoramic windows, marble bathroom, private terrace, and butler service. Perfect for royal treatment.
                    </div>
                    <div class="amenities-badge">
                        <span>🌊 Sea view</span>
                        <span>🛁 Jacuzzi</span>
                        <span>🍾 Minibar</span>
                    </div>
                    <div class="card-tag">⭐ Exclusive access</div>
                </div>
            </div>

            <!-- CARD 2 - Infinity Pool & Sun Deck -->
            <div class="hotel-card">
                <div class="card-img">
                    <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Infinity+Pool+Deck" alt="Infinity Pool with City Skyline">
                </div>
                <div class="card-content">
                    <h3>Infinity Pool</h3>
                    <div class="card-location">Rooftop • Heated</div>
                    <div class="card-description">
                        Heated infinity pool overlooking the skyline. Cocktail bar, premium loungers, and sunset yoga every evening. Unwind in style.
                    </div>
                    <div class="amenities-badge">
                        <span>🍹 Pool bar</span>
                        <span>🧘‍♀️ Yoga deck</span>
                        <span>🌅 Sunset view</span>
                    </div>
                    <div class="card-tag">✨ Guest favorite</div>
                </div>
            </div>

            <!-- CARD 3 - Gourmet Restaurant “Amber” -->
            <div class="hotel-card">
                <div class="card-img">
                    <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Gourmet+Restaurant" alt="Fine dining restaurant interior">
                </div>
                <div class="card-content">
                    <h3>Amber Restaurant</h3>
                    <div class="card-location">Michelin Starred Cuisine</div>
                    <div class="card-description">
                        Exquisite fusion menu crafted by chef Maria Lombardi. Private dining rooms, wine cellar, and seasonal tasting menus.
                    </div>
                    <div class="amenities-badge">
                        <span>🥂 Wine pairing</span>
                        <span>🌿 Organic</span>
                        <span>🎻 Live jazz</span>
                    </div>
                    <div class="card-tag">🍽️ Reservations recommended</div>
                </div>
            </div>

            <!-- CARD 4 - Luxury Spa & Wellness -->
            <div class="hotel-card">
                <div class="card-img">
                    <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Harmony+Spa" alt="Serene spa with massage treatment">
                </div>
                <div class="card-content">
                    <h3>Harmony Spa</h3>
                    <div class="card-location">Tranquil Garden Level</div>
                    <div class="card-description">
                        Signature treatments, sauna, steam room, and organic facials. Recharge your senses with our holistic rituals.
                    </div>
                    <div class="amenities-badge">
                        <span>💆 Hot stone</span>
                        <span>🧖 Sauna</span>
                        <span>🍵 Herbal tea</span>
                    </div>
                    <div class="card-tag">🌸 Couples packages</div>
                </div>
            </div>

            <!-- CARD 5 - Deluxe Family Room -->
            <div class="hotel-card">
                <div class="card-img">
                    
                    <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Family+Suite" alt="Spacious family room with bunk beds">
                </div>
                <div class="card-content">
                    <h3>Family Suite</h3>
                    <div class="card-location">Connecting rooms • Park view</div>
                    <div class="card-description">
                        Two bedrooms, kid-friendly amenities, gaming console, and a private balcony. Ideal for unforgettable family memories.
                    </div>
                    <div class="amenities-badge">
                        <span>🧸 Kids zone</span>
                        <span>📺 Streaming</span>
                        <span>🍼 Baby kit</span>
                    </div>
                    <div class="card-tag">👪 up to 6 guests</div>
                </div>
            </div>

            <!-- CARD 6 - Rooftop Garden Lounge -->
            <div class="hotel-card">
                <div class="card-img">
                    <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Garden+Lounge" alt="Rooftop garden with city lights">
                </div>
                <div class="card-content">
                    <h3>Sky Garden Lounge</h3>
                    <div class="card-location">Open-air • 360° views</div>
                    <div class="card-description">
                        Lush botanical rooftop with signature mocktails, live DJ on weekends, and fire pits. The perfect evening escape.
                    </div>
                    <div class="amenities-badge">
                        <span>🌿 Botanical bar</span>
                        <span>🎵 Live music</span>
                        <span>📸 Photo spot</span>
                    </div>
                    <div class="card-tag">🌙 Open until midnight</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BONUS: Secondary area (pool + meeting hall with images & description) - extra demonstration -->
    <div class="extra-showcase">
        <div class="inline-flex">
            <div class="section-title" style="margin-bottom: 2rem;">
                <h2>More luxury spaces</h2>
                <span></span>
            </div>
            <div class="grid-2col">
                <div class="feature-card">
                    <div class="feature-img">
                        <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Grand+Ballroom" alt="Grand ballroom events">
                    </div>
                    <div class="feature-text">
                        <h4>Grand Ballroom</h4>
                        <p>Elegant venue for weddings & galas, crystal chandeliers, and state-of-the-art acoustics. Accommodates up to 400 guests. Our event team curates every detail.</p>
                        <div class="card-tag" style="margin-top: 0.8rem;">🎤 Concierge events</div>
                    </div>
                </div>
                <div class="feature-card">
                    <div class="feature-img">
                        <img src="https://placehold.co/600x400/FFC8DD/ad8cff?text=Fitness+Center" alt="Modern fitness studio">
                    </div>
                    <div class="feature-text">
                        <h4>Elite Fitness & Studio</h4>
                        <p>24/7 gym with personal trainers, pilates studio, steam room, and smoothie bar. Stay on track while enjoying resort-class amenities.</p>
                        <div class="card-tag" style="margin-top: 0.8rem;">🏋️‍♂️ Free for guests</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <footer class="footer">
        <p style="margin-top: 1rem; opacity: 0.7;">© 2026 <span class="logo">RE:Ception</span> Hotel Network — Experience elevated comfort.</p>
    </footer>
