@page "/register"

<PageTitle>register</PageTitle>
<div class="login_container">
    <form action="" method="get">
        <div class="login_form">
            <label>
                <span></span> First name
            </label>
            <input type="text" name="First_name" id="first_name" placeholder="Иван" required/>
        </div>
        <div class="login_form">
            <label>
                <span></span> Last name
            </label>
            <input type="text" name="Last_name" id="last_name" placeholder="Иванов" required/>
        </div>
        <div class="login_form">
            <label>
                <span></span> Gender
            </label>
            <select name="gender" id="gender_id" required>
                <option value="">--Please choose your gender--</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="rather_not_say">Rather not say</option>
            </select>
        </div>
        <div class="login_form">
            <label>
            <span></span> Phone number
            </label>
            <input type="text" name="phone_number" id="phone" placeholder="+7xxx-xxx-xx-xx"/>
        </div>
            <div class="login_form">
            <input type="submit" value="Register" />
        </div>
    </form>
</div>